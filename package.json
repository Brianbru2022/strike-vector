    "stage6:audio:audit": "tsx scripts/audit-stage6-audio.ts",
    "stage6:gate": "pnpm lint && pnpm test && pnpm stage6:audio:audit && pnpm visual:manifest:audit && tsx scripts/verify-stage6-release.ts",
