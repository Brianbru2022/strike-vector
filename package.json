    "stage9:art": "python scripts/prepare_stage9_store_art.py",
    "stage9:capture": "tsx scripts/capture-storefront-media.ts",
    "stage9:audit": "tsx scripts/audit-stage9-commercial.ts",
    "stage9:gate": "pnpm lint && pnpm test && pnpm legal:generate && pnpm rights:audit && pnpm legal:audit && pnpm stage9:audit && tsx scripts/audit-stage9-commercial.ts --strict",
    "stage10:identity": "tsx scripts/audit-stage10-identity.ts",
    "stage10:manifest": "tsx scripts/stage10-manifest.ts",
    "stage10:test:e2e": "playwright test --config playwright.release.config.ts",
    "stage10:soak": "tsx scripts/run-stage10-soak.ts",
    "stage10:soak:smoke": "tsx scripts/run-stage10-soak.ts --smoke",
    "stage10:audit": "tsx scripts/audit-stage10-release.ts",
    "stage10:prepare": "tsx scripts/run-stage10-preparation.ts",
    "stage10:gate": "pnpm stage10:prepare && pnpm stage9:gate && tsx scripts/audit-stage10-release.ts --strict",
    "effects:capture": "tsx scripts/capture-combat-effects.ts",
    "showcase:capture": "tsx scripts/capture-showcase-media.ts",
    "capture:norwegian": "tsx scripts/capture-norwegian-release.ts"
